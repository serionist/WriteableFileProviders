# Code style: one line per rule, with its reason where it isn't obvious. A project builds with EnforceCodeStyleInBuild
# and TreatWarningsAsErrors (Directory.Build.targets), so every `warning` here fails its build; a project that still
# holds code from before the modernization sets WfpLegacy, which turns both off until its rewrite.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets,slnx,runsettings,xml}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in markdown.
trim_trailing_whitespace = false

[*.cs]
indent_size = 4
max_line_length = 120

# --- Language conventions ---
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# `var` is neither required nor banned: enforcing one direction without the other is incoherent.
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent
dotnet_diagnostic.IDE0007.severity = none
dotnet_diagnostic.IDE0008.severity = none

# Braces are optional: the guard-clause one-liner `if (x) return;` is house style.
csharp_prefer_braces = true:silent
dotnet_diagnostic.IDE0011.severity = none

csharp_style_expression_bodied_methods = when_on_single_line:warning
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_accessors = true:warning

dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
csharp_prefer_static_local_function = true:warning
csharp_style_prefer_index_operator = true:warning
csharp_style_prefer_range_operator = true:warning
csharp_style_unused_value_expression_statement_preference = discard_variable:silent

# --- Analyzers: each rule is `warning` or `none` with its reason ---

# Kept.
dotnet_diagnostic.IDE0003.severity = warning   # no `this.`
dotnet_diagnostic.IDE0022.severity = warning   # expression body for single-line methods
dotnet_diagnostic.IDE0025.severity = warning   # expression body for properties
dotnet_diagnostic.IDE0027.severity = warning   # expression body for accessors
dotnet_diagnostic.IDE0028.severity = warning   # collection expressions
dotnet_diagnostic.IDE0031.severity = warning   # null propagation
dotnet_diagnostic.IDE0042.severity = warning   # deconstruct tuple declarations
dotnet_diagnostic.IDE0056.severity = warning   # index operator
dotnet_diagnostic.IDE0057.severity = warning   # range operator
dotnet_diagnostic.IDE0059.severity = warning   # unnecessary assignment
dotnet_diagnostic.IDE0060.severity = warning   # unused parameter
dotnet_diagnostic.IDE0062.severity = warning   # static local function
dotnet_diagnostic.IDE0063.severity = warning   # `using` declaration
dotnet_diagnostic.IDE0090.severity = warning   # `new()` target-typed
dotnet_diagnostic.IDE0130.severity = warning   # namespace matches the folder
dotnet_diagnostic.IDE0270.severity = warning   # null check simplification
dotnet_diagnostic.IDE0290.severity = warning   # primary constructors
dotnet_diagnostic.IDE0300.severity = warning   # collection expression for arrays
dotnet_diagnostic.IDE0301.severity = warning   # collection expression for empty
dotnet_diagnostic.IDE0305.severity = warning   # collection expression for fluent calls
dotnet_diagnostic.IDE0330.severity = warning   # System.Threading.Lock
dotnet_diagnostic.IDE0340.severity = warning   # unbound generic type
dotnet_diagnostic.IDE1006.severity = warning   # the naming rules below; a rule's own severity reaches the IDE only
dotnet_diagnostic.CA1068.severity = warning    # CancellationToken goes last
dotnet_diagnostic.CA1816.severity = warning    # Dispose calls SuppressFinalize
dotnet_diagnostic.CA1822.severity = warning    # mark members static
dotnet_diagnostic.CA1861.severity = warning    # constant array arguments become static readonly
dotnet_diagnostic.CA1875.severity = warning    # Regex.Count over Matches().Count
dotnet_diagnostic.CA2007.severity = warning    # ConfigureAwait(false): a library must not capture its caller's context
dotnet_diagnostic.SYSLIB1045.severity = warning  # [GeneratedRegex]; relaxed for tests in tests/WriteableFileProviders.Tests/.editorconfig

# Off.
# CA1859: IReadOnlyList, IReadOnlyDictionary and IReadOnlySet return types are an immutability contract.
dotnet_diagnostic.CA1859.severity = none

# --- Naming ---
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = i_prefix_pascal
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *
dotnet_naming_style.i_prefix_pascal.capitalization = pascal_case
dotnet_naming_style.i_prefix_pascal.required_prefix = I

dotnet_naming_rule.types_pascal.severity = warning
dotnet_naming_rule.types_pascal.symbols = type_symbols
dotnet_naming_rule.types_pascal.style = pascal
dotnet_naming_symbols.type_symbols.applicable_kinds = class, struct, enum, delegate
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.members_pascal.severity = warning
dotnet_naming_rule.members_pascal.symbols = member_symbols
dotnet_naming_rule.members_pascal.style = pascal
dotnet_naming_symbols.member_symbols.applicable_kinds = method, property, event

dotnet_naming_rule.consts_pascal.severity = warning
dotnet_naming_rule.consts_pascal.symbols = const_symbols
dotnet_naming_rule.consts_pascal.style = pascal
dotnet_naming_symbols.const_symbols.applicable_kinds = field
dotnet_naming_symbols.const_symbols.required_modifiers = const

dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_rule.async_suffix.severity = warning
dotnet_naming_rule.async_suffix.symbols = async_methods
dotnet_naming_rule.async_suffix.style = end_in_async
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.end_in_async.capitalization = pascal_case
dotnet_naming_style.end_in_async.required_suffix = Async
