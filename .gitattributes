# LF for every text file in the repo. Git already stores them with LF; this also makes a checkout LF on every OS, so
# what an editor sees matches .editorconfig and what is committed.
* text=auto eol=lf

# Visual Studio rewrites solution files with CRLF on save; keeping them CRLF in the checkout avoids a diff on every save.
*.sln    text eol=crlf

# Windows batch files break with LF line endings (labels, goto); they stay CRLF.
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binary: never normalized.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.snk    binary
*.pfx    binary
*.p12    binary
