<Project>

  <!-- Central package management: every package version lives here, and a .csproj names packages without versions.
       Transitive pinning is off, so a package's nuspec lists only what it references. To fix an advisory in a
       transitive package, reference it directly in the project that brings it in, with a comment naming the advisory:
       consumers then get the fix too. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Common">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Physical" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Provider SDKs">
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.5" />
    <!-- Shared by AzureBlob and SharePoint. Since 1.21.0 its types live in Azure.Core and the package forwards them; a
         reference keeps a consumer's own Azure.Identity at 1.21.0 or later, so the types are never defined twice. -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="Box.V2.Core" Version="10.19.0" />
    <PackageVersion Include="Google.Cloud.Storage.V1" Version="5.0.0" />
    <PackageVersion Include="Microsoft.Graph" Version="6.8.0" />
    <PackageVersion Include="Microsoft.Graph.Core" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup Label="Build">
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="MSTest.Analyzers" Version="4.5.1" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.FakeGcsServer" Version="4.16.0" />
  </ItemGroup>

</Project>
