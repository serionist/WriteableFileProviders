<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Description>WriteableAmazonS3FileProvider implementation if IWriteableFileProvider.
WriteableFileProviders is a project aimed to provide writeable access to different file providers while also being usable as a standard ASP.NET Core IFileProvider.</Description>
    <Authors>Soma Osvay</Authors>
    <PackageProjectUrl>https://serionist.visualstudio.com/WriteableFileProviders</PackageProjectUrl>
    <RepositoryUrl>https://serionist.visualstudio.com/_git/WriteableFileProviders</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="3.7.305.22" />
    <PackageReference Include="WriteableFileProviders.Common" Version="2026.10.10.4" Condition="'$(UseLocalCommon)' != 'true'" />
    <ProjectReference Include="..\WriteableFileProviders.Common\WriteableFileProviders.Common.csproj" Condition="'$(UseLocalCommon)' == 'true'" />
  </ItemGroup>

</Project>
