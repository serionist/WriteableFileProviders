<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Description>WriteableGoogleCloudStorageFileProvider implementation if IWriteableFileProvider.
WriteableFileProviders is a project aimed to provide writeable access to different file providers while also being usable as a standard ASP.NET Core IFileProvider.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.Storage.V1" Version="4.15.0" />
    <PackageReference Include="WriteableFileProviders.Common" Version="2026.10.10.4" Condition="'$(UseLocalCommon)' != 'true'" />
    <ProjectReference Include="..\WriteableFileProviders.Common\WriteableFileProviders.Common.csproj" Condition="'$(UseLocalCommon)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WriteableFileProviders.Tests" />
  </ItemGroup>

</Project>
