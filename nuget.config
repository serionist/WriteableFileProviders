<?xml version="1.0" encoding="utf-8"?>
<!-- Package sources: nuget.org only, whatever feeds a contributor's machine has configured. Every package maps to exactly
     one source, so a package with the same name on another feed can never be picked up by accident. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
