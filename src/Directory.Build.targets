<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

  <!-- IsAotCompatible makes the SDK reference the trim analyzer's package, Microsoft.NET.ILLink.Tasks, at the SDK's own
       runtime version, which the lock files then hold: every SDK patch would change it and fail a locked restore. It is
       pinned here instead, so an SDK update leaves the lock files alone; raise it on purpose, and restore to update
       them. -->
  <ItemGroup>
    <KnownILLinkPack Update="@(KnownILLinkPack)" ILLinkPackVersion="10.0.12" />
  </ItemGroup>

  <!-- Every package releases at one version, and a package of one major does not load against Common of another: its
       types are not there. So a packed dependency on one of our packages is bounded above by the next major and its
       prereleases, [V, NextMajor.0.0-0) (-0 is the lowest prerelease), and mixing majors gives a restore warning
       (NU1608) or error (NU1107) instead of a failure at run time. NuGet packs a project reference as >= V and has no
       setting for an upper bound (NuGet/Home#5556), so this rewrites the version it read from each referenced project
       before the nuspec is written. eng/package-check.cs checks the result. -->

  <!-- NU5104 ("a stable release should not have a prerelease dependency") reads the -0 above as a prerelease
       dependency, and with warnings as errors it fails the pack of every stable release. The -0 is only the exclusive
       upper bound that keeps the next major's prereleases out; the lowest version a package depends on is always the
       release's own, stable for a stable release. CI packs a stable version on every PR to keep this proven. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>
  <Target Name="WfpBoundProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions"
          Condition="'$(MinVerMajor)' != ''">
    <PropertyGroup>
      <_WfpNextMajor>$([MSBuild]::Add($(MinVerMajor), 1))</_WfpNextMajor>
    </PropertyGroup>
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)"
                                      ProjectVersion="[%(ProjectVersion), $(_WfpNextMajor).0.0-0)" />
    </ItemGroup>
  </Target>

</Project>
