<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>WriteableFileProviders.AmazonS3</PackageId>
    <Description>Amazon S3 and S3-compatible storage as a writeable IFileProvider: read, write, append, list, copy and move objects in a bucket through IWriteableFileProvider, on the AWS SDK for .NET v4, with multipart uploads, conditional writes, byte ranges and presigned URLs. The same API as the local disk, Azure Blob, MinIO, Google Cloud Storage, Box and SharePoint providers. Native AOT compatible.</Description>
    <PackageTags>$(PackageTags);aws;amazon;s3;amazon-s3;s3-compatible;presigned-url;object-storage;aot;native-aot;trimming</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- The S3 protocol, shared with WriteableFileProviders.Minio: each package compiles its own internal copy, so neither
         depends on the other. -->
    <Compile Include="..\Shared\S3\*.cs" LinkBase="S3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WriteableFileProviders.Common\WriteableFileProviders.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WriteableFileProviders.AmazonS3.Tests" />
  </ItemGroup>

</Project>
