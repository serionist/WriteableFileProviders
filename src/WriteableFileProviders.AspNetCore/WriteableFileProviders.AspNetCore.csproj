<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>WriteableFileProviders.AspNetCore</PackageId>
    <Description>Signed download and upload URLs for every WriteableFileProviders store in ASP.NET Core, the local disk included: IWriteableFileUrlService returns the store's own presigned or SAS URL where it can sign one, else a URL of a gateway in your app that serves GET, HEAD (with ranges) and PUT on Data Protection tokens.</Description>
    <PackageTags>$(PackageTags);aspnetcore;asp-net-core;presigned-url;gateway;file-download;file-upload</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WriteableFileProviders.Common\WriteableFileProviders.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WriteableFileProviders.AspNetCore.Tests" />
  </ItemGroup>

</Project>
