<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>WriteableFileProviders.AzureBlob</PackageId>
    <Description>Azure Blob Storage as a writeable IFileProvider: read, write, append, list, copy and move blobs in a container through IWriteableFileProvider, on block blobs, with conditional writes, byte ranges, Microsoft Entra ID sign-in and SAS URLs (service or user delegation). The same API as the local disk, Amazon S3, MinIO, Google Cloud Storage, Box and SharePoint providers.</Description>
    <PackageTags>$(PackageTags);azure;azure-blob;azure-storage;blob-storage;sas</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- DefaultAzureCredential, for UseDefaultAzureCredential. -->
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Storage.Blobs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WriteableFileProviders.Common\WriteableFileProviders.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WriteableFileProviders.AzureBlob.Tests" />
  </ItemGroup>

</Project>
