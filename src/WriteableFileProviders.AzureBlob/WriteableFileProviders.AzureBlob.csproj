<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>WriteableFileProviders.AzureBlob</PackageId>
    <Description>WriteableFileProviders for Azure Blob Storage: a writeable IFileProvider over a blob container, on block blobs, with atomic and conditional writes, appends that never lose a concurrent write, ranged reads, server-side copies and SAS URLs (service or user delegation).</Description>
    <PackageTags>$(PackageTags);azure;azure-storage;blob;blob-storage</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- DefaultAzureCredential, for UseDefaultAzureCredential. -->
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Storage.Blobs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WriteableFileProviders.Common\WriteableFileProviders.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WriteableFileProviders.AzureBlob.Tests" />
  </ItemGroup>

</Project>
