<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>WriteableFileProviders.Box</PackageId>
    <Description>Box as a writeable IFileProvider: read, write, append, list, copy and move files in a Box folder through IWriteableFileProvider, on the Box .NET SDK (Box.Sdk.Gen), with JWT sign-in, chunked uploads, byte ranges pinned to a file version and Box download URLs. The same API as the local disk, Azure Blob, Amazon S3, MinIO, Google Cloud Storage and SharePoint providers.</Description>
    <PackageTags>$(PackageTags);box;box-api;box-sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ranged read of a download, shared with Common, GoogleCloudStorage and SharePoint: each package compiles its own
         internal copy. -->
    <Compile Include="..\Shared\SliceReadStream.cs" Link="Shared\SliceReadStream.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Box.V2.Core" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" VersionOverride="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WriteableFileProviders.Common\WriteableFileProviders.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WriteableFileProviders.Box.Tests" />
  </ItemGroup>

</Project>
