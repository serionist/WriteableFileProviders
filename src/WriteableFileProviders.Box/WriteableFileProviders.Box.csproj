<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>WriteableFileProviders.Box</PackageId>
    <Description>WriteableFileProviders for Box: a writeable IFileProvider over a Box folder, on the Box .NET SDK (Box.Sdk.Gen), with JWT sign-in, chunked uploads, ranged reads pinned to a file version, server-side copies and moves, and Box's pre-authenticated download URLs.</Description>
    <PackageTags>$(PackageTags);box;box-api</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ranged read of a download, shared with Common, GoogleCloudStorage and SharePoint: each package compiles its own
         internal copy. -->
    <Compile Include="..\Shared\SliceReadStream.cs" Link="Shared\SliceReadStream.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Box.V2.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WriteableFileProviders.Common\WriteableFileProviders.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WriteableFileProviders.Box.Tests" />
  </ItemGroup>

</Project>
