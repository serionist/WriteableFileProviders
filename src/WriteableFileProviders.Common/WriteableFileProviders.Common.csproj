<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>WriteableFileProviders</RootNamespace>
    <PackageId>WriteableFileProviders.Common</PackageId>
    <Description>One writeable IFileProvider for .NET that means the same on the local disk, Azure Blob Storage, Amazon S3, MinIO, Google Cloud Storage, Box and SharePoint: IWriteableFileProvider (async reads, writes, appends, byte ranges, conditional writes, copies, moves, listings and signed URLs), the base class providers build on, configuration and dependency injection. Install a provider package, which brings this one. Native AOT compatible.</Description>
    <PackageTags>$(PackageTags);abstractions;dependency-injection;aot;native-aot;trimming</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ranged read of a download, shared with Box, GoogleCloudStorage and SharePoint: each package compiles its own
         internal copy. -->
    <Compile Include="..\Shared\SliceReadStream.cs" Link="Shared\SliceReadStream.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WriteableFileProviders.Common.Tests" />
  </ItemGroup>

</Project>
