<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>WriteableFileProviders</RootNamespace>
    <PackageId>WriteableFileProviders.Common</PackageId>
    <Description>The core of WriteableFileProviders: IWriteableFileProvider, a writeable IFileProvider that means the same thing on every storage backend; the base class providers build on; byte-range and seekable reads, conditional writes, signed URLs; construction from configuration or JSON, and dependency injection.</Description>
    <PackageTags>$(PackageTags);abstractions</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WriteableFileProviders.Common.Tests" />
  </ItemGroup>

</Project>
