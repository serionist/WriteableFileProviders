<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>WriteableFileProviders.GoogleCloudStorage</PackageId>
    <Description>Google Cloud Storage as a writeable IFileProvider: read, write, append, list, copy and move objects in a bucket through IWriteableFileProvider, with resumable uploads, generation preconditions, byte ranges and V4 signed URLs. The same API as the local disk, Azure Blob, Amazon S3, MinIO, Box and SharePoint providers.</Description>
    <PackageTags>$(PackageTags);gcs;gcp;google-cloud;google-cloud-storage;object-storage</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ranged read of a download, shared with Common, Box and SharePoint: each package compiles its own
         internal copy. -->
    <Compile Include="..\Shared\SliceReadStream.cs" Link="Shared\SliceReadStream.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.Storage.V1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WriteableFileProviders.Common\WriteableFileProviders.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WriteableFileProviders.GoogleCloudStorage.Tests" />
  </ItemGroup>

</Project>
