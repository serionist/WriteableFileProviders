<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>WriteableFileProviders.GoogleCloudStorage</PackageId>
    <Description>WriteableFileProviders for Google Cloud Storage: a writeable IFileProvider over a bucket, with resumable uploads, generation preconditions, ranged reads, server-side copies and V4 signed URLs.</Description>
    <PackageTags>$(PackageTags);gcp;google-cloud;google-cloud-storage;gcs</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.Storage.V1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WriteableFileProviders.Common\WriteableFileProviders.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WriteableFileProviders.GoogleCloudStorage.Tests" />
  </ItemGroup>

</Project>
