<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>WriteableFileProviders.Minio</PackageId>
    <Description>MinIO as a writeable IFileProvider: read, write, append, list, copy and move objects in a bucket through IWriteableFileProvider, on the AWS SDK for .NET v4 (no Minio SDK), with multipart uploads, byte ranges and presigned URLs. The same API as the local disk, Azure Blob, Amazon S3, Google Cloud Storage, Box and SharePoint providers.</Description>
    <PackageTags>$(PackageTags);minio;s3;s3-compatible;presigned-url;object-storage</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- The S3 protocol, shared with WriteableFileProviders.AmazonS3: each package compiles its own internal copy, so
         neither depends on the other. -->
    <Compile Include="..\Shared\S3\*.cs" LinkBase="S3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WriteableFileProviders.Common\WriteableFileProviders.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WriteableFileProviders.Minio.Tests" />
  </ItemGroup>

</Project>
