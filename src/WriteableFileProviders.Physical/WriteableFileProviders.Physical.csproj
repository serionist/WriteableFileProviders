<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>WriteableFileProviders.Physical</PackageId>
    <Description>WriteableFileProviders for the local file system: a writeable IFileProvider over a folder on disk, with atomic writes and appends, conditional writes, ranged reads and change notifications.</Description>
    <PackageTags>$(PackageTags);filesystem;local;disk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- PhysicalFileProvider and its PhysicalFilesWatcher, behind Watch. -->
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WriteableFileProviders.Common\WriteableFileProviders.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests set the choices that differ by OS (IgnoresCase, RenamesWithoutReplacing) and the clock. -->
    <InternalsVisibleTo Include="WriteableFileProviders.Physical.Tests" />
  </ItemGroup>

</Project>
