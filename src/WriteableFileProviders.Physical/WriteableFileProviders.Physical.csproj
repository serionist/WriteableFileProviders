<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>WriteableFileProviders.Physical</PackageId>
    <Description>Read, write, list and watch files in a folder on the local disk through IWriteableFileProvider: atomic writes and appends, conditional writes, byte-range and seekable reads, change notifications. The same API as the Azure Blob, Amazon S3, MinIO, Google Cloud Storage, Box and SharePoint providers. Native AOT compatible.</Description>
    <PackageTags>$(PackageTags);local;disk;local-storage;physical;aot;native-aot;trimming</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- PhysicalFileProvider and its PhysicalFilesWatcher, behind Watch. -->
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WriteableFileProviders.Common\WriteableFileProviders.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests set the choices that differ by OS (IgnoresCase, RenamesWithoutReplacing) and the clock. -->
    <InternalsVisibleTo Include="WriteableFileProviders.Physical.Tests" />
  </ItemGroup>

</Project>
