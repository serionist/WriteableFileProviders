<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>WriteableFileProviders.SharePoint</PackageId>
    <Description>WriteableFileProviders for SharePoint document libraries: a writeable IFileProvider over a library through Microsoft Graph, with upload sessions, ranged reads, server-side copies and moves, and pre-authenticated download URLs.</Description>
    <PackageTags>$(PackageTags);sharepoint;microsoft-graph;office365;m365</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ranged read of a download, shared with Common, Box and GoogleCloudStorage: each package compiles its own
         internal copy. -->
    <Compile Include="..\Shared\SliceReadStream.cs" Link="Shared\SliceReadStream.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Graph" />
    <PackageReference Include="Microsoft.Graph.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WriteableFileProviders.Common\WriteableFileProviders.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WriteableFileProviders.SharePoint.Tests" />
  </ItemGroup>

</Project>
