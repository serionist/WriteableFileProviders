<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>WriteableFileProviders.SharePoint</PackageId>
    <Description>SharePoint document libraries as a writeable IFileProvider: read, write, append, list, copy and move files through IWriteableFileProvider and Microsoft Graph, with upload sessions, byte ranges, sign-in by secret, certificate or managed identity, and download URLs. The same API as the local disk, Azure Blob, Amazon S3, MinIO, Google Cloud Storage and Box providers. Native AOT compatible.</Description>
    <PackageTags>$(PackageTags);sharepoint;microsoft-graph;m365;office365;document-library;aot;native-aot;trimming</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ranged read of a download, shared with Common, Box and GoogleCloudStorage: each package compiles its own
         internal copy. -->
    <Compile Include="..\Shared\SliceReadStream.cs" Link="Shared\SliceReadStream.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Graph" />
    <PackageReference Include="Microsoft.Graph.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WriteableFileProviders.Common\WriteableFileProviders.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WriteableFileProviders.SharePoint.Tests" />
  </ItemGroup>

</Project>
