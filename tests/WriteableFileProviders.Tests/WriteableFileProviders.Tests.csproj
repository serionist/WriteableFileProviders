<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <WfpLegacy>true</WfpLegacy>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="testsettings.json" />
    <!-- Optional: real credentials for the live suites. Absent, those suites fail or are inconclusive; nothing else needs it. -->
    <Content Include="testsettings.json" Condition="Exists('testsettings.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WriteableFileProviders.AmazonS3\WriteableFileProviders.AmazonS3.csproj" />
    <ProjectReference Include="..\..\src\WriteableFileProviders.Common\WriteableFileProviders.Common.csproj" />
    <ProjectReference Include="..\..\src\WriteableFileProviders.Minio\WriteableFileProviders.Minio.csproj" />
    <ProjectReference Include="..\..\src\WriteableFileProviders.Physical\WriteableFileProviders.Physical.csproj" />
  </ItemGroup>

</Project>
