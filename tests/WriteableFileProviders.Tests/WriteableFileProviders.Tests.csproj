<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <WfpLegacy>true</WfpLegacy>
    <!-- No test is left here: every provider has moved to a test project of its own, Physical last (#9). It builds as a
         plain library, not a test application, so dotnet test does not fail on a run of zero tests (exit code 8); S12
         deletes the project. -->
    <IsTestProject>false</IsTestProject>
    <EnableMSTestRunner>false</EnableMSTestRunner>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="testsettings.json" />
    <!-- Optional: real credentials for the live suites. Absent, those suites fail or are inconclusive; nothing else needs it. -->
    <Content Include="testsettings.json" Condition="Exists('testsettings.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WriteableFileProviders.Common\WriteableFileProviders.Common.csproj" />
  </ItemGroup>

</Project>
